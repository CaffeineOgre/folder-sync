# ==========================================
# .gitignore
# Supports: Vim, Windows, macOS, Linux, Go, VS Code, Claude, Antigravity
# ==========================================

# ------------------------------------------
# Operating Systems
# ------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ------------------------------------------
# Editors & IDEs
# ------------------------------------------

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
*.un~
Session.vim
Sessionx.vim
.netrwhist

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-snippets
*.code-workspace
.history/
.ionide/

# ------------------------------------------
# AI & Coding Assistants
# ------------------------------------------

# Claude
.claude/
CLAUDE.md.user
claude.config.json

# Antigravity
.gemini/
.antigravity/
brain/
scratch/

# ------------------------------------------
# Go (Golang)
# ------------------------------------------

# Binaries and compiled output
*.exe
*.exe;
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# Architecture specific extensions
*.a
*.o

# Vendor directory
vendor/

# Go workspace
go.work
go.work.sum

# Test & coverage profiles
*.cover
*.coverage
cover.out
